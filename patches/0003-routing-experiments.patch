+// experiment: GGML_MOE_CACHE_BIAS=lambda multiplies the router probabilities used for expert SELECTION by (1 + lambda) for experts that are resident in the read pool
+// (single-token steps only); the mixing weights still come from the unmodified probabilities. Unset = no change.
+typedef int (*moe_pool_mask_fn_t)(int, int, unsigned char *);
+struct moe_bias_ud { int layer; float lambda; moe_pool_mask_fn_t fn; };
+static void moe_bias_op(struct ggml_tensor * dst, const struct ggml_tensor * a, int ith, int nth, void * ud_) {
+    (void) nth; if (ith != 0) return;
+    const moe_bias_ud * ud = (const moe_bias_ud *) ud_;
+    const int64_t ne = a->ne[0], nt = a->ne[1];
+    std::vector<unsigned char> mask(ne, 0);
+    const bool use = nt == 1 && ud->fn && ud->fn(ud->layer, (int) ne, mask.data());
+    for (int64_t t = 0; t < nt; ++t) {
+        const float * src = (const float *) ((const char *) a->data + t * a->nb[1]); float * out = (float *) ((char *) dst->data + t * dst->nb[1]);
+        for (int64_t e = 0; e < ne; ++e) out[e] = src[e] * ((use && mask[e]) ? (1.0f + ud->lambda) : 1.0f);
+    }
+}
