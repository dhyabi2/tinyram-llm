+}
+
+// Hot-set pinning (experiment): GGML_MOE_PIN=<file> with lines "<layer> <expert>". The first time a layer's expert tensor runs, the byte range of every
+// listed expert inside the mmap is mlock'ed, so those pages are read once and then stay resident. GGML_MOE_PIN_LOG=1 prints what was pinned.
+#define MOE_PIN_MAX_L 128
+#define MOE_PIN_MAX_E 1024
+static unsigned char moe_pin_set[MOE_PIN_MAX_L][MOE_PIN_MAX_E];
+static const void *  moe_pin_done[1024];
+static int           moe_pin_ndone = 0;
+static int           moe_pin_state = -1;   // -1 not read yet, 0 disabled, 1 enabled
+static size_t        moe_pin_bytes = 0;
+static int           moe_pin_fail  = 0;
+
+static void ggml_moe_pin_apply(const struct ggml_tensor * src0) {
+#if !defined(_WIN32)
+    if (moe_pin_state < 0) {
+        moe_pin_state = 0;
+        const char * path = getenv("GGML_MOE_PIN");
+        FILE * f = path ? fopen(path, "r") : NULL;
+        if (f) {
+            int l, e;
+            while (fscanf(f, "%d %d", &l, &e) == 2) {
+                if (l >= 0 && l < MOE_PIN_MAX_L && e >= 0 && e < MOE_PIN_MAX_E) { moe_pin_set[l][e] = 1; moe_pin_state = 1; }
+            }
+            fclose(f);
+        }
+    }
+    if (moe_pin_state != 1 || !strstr(src0->name, "_exps")) {
+        return;
+    }
+    for (int i = 0; i < moe_pin_ndone; ++i) {
+        if (moe_pin_done[i] == src0->data) { return; }
+    }
+    int layer = -1;
+    if (sscanf(src0->name, "blk.%d.", &layer) != 1 || layer < 0 || layer >= MOE_PIN_MAX_L || moe_pin_ndone >= 1024) {
+        return;
+    }
+    moe_pin_done[moe_pin_ndone++] = src0->data;
+    const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+    const int64_t n_as = src0->ne[2];
+    int64_t e = 0;
+    while (e < n_as) {
+        if (e >= MOE_PIN_MAX_E || !moe_pin_set[layer][e]) { ++e; continue; }
+        int64_t e2 = e;                                        // coalesce a run of consecutive pinned experts into one mlock
+        while (e2 + 1 < n_as && e2 + 1 < MOE_PIN_MAX_E && moe_pin_set[layer][e2 + 1]) { ++e2; }
+        uintptr_t a = (uintptr_t) src0->data + (size_t) e * src0->nb[2];
+        uintptr_t b = (uintptr_t) src0->data + (size_t)(e2 + 1) * src0->nb[2];
+        a &= ~(uintptr_t)(page - 1);
+        b = (b + page - 1) & ~(uintptr_t)(page - 1);
+        if (mlock((void *) a, (size_t)(b - a)) == 0) { moe_pin_bytes += (size_t)(b - a); } else { moe_pin_fail++; }
+        e = e2 + 1;
+    }
+    if (getenv("GGML_MOE_PIN_LOG") && layer == 47) {
+        fprintf(stderr, "moe-pin: %.1f MiB locked so far, %d mlock failures\n", moe_pin_bytes / 1048576.0, moe_pin_fail);
+    }
+#else
+    GGML_UNUSED(src0);
+#endif
+}
