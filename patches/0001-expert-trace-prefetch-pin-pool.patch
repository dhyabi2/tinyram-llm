+#if !defined(_WIN32)
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+// Expert prefetch (experiment). With GGML_MOE_PREFETCH=1, the experts the router picked for this op are asked for as whole byte ranges
+// (madvise WILLNEED) before any of them is touched, so the kernel reads each expert in large pieces with many requests in flight instead of
+// faulting 4-128 KiB at a time at queue depth 1. A no-op for data that is not file-backed.
+static int ggml_moe_prefetch_mode(void) {
+    static int mode = -1;
+    if (mode < 0) {
+        const char * e = getenv("GGML_MOE_PREFETCH");
+        mode = e ? atoi(e) : 0;
+    }
+    return mode;
+}
+
+static void ggml_moe_prefetch(const struct ggml_tensor * src0, const struct ggml_tensor * ids) {
+#if !defined(_WIN32)
+    const int64_t n_as = src0->ne[2];
+    const size_t  page = (size_t) sysconf(_SC_PAGESIZE);
+    uint8_t * seen = (uint8_t *) alloca((size_t) n_as);
+    memset(seen, 0, (size_t) n_as);
+    for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+        for (int64_t id = 0; id < ids->ne[0]; ++id) {
+            const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
+            if (i02 < 0 || i02 >= n_as || seen[i02]) {
+                continue;
+            }
+            seen[i02] = 1;
+            uintptr_t a = (uintptr_t) src0->data + (size_t) i02 * src0->nb[2];
+            uintptr_t b = a + src0->nb[2];
+            a &= ~(uintptr_t)(page - 1);
+            b = (b + page - 1) & ~(uintptr_t)(page - 1);
+            madvise((void *) a, (size_t)(b - a), MADV_WILLNEED);
+        }
+    }
+#else
+    GGML_UNUSED(src0); GGML_UNUSED(ids);
+#endif
+}
+
+// Mode 2: every compute thread touches its share of the chosen experts' pages before the matmul, so the page faults are issued
+// from nth threads at once (queue depth nth) instead of one at a time as the matmul walks the rows.
+static void ggml_moe_prefetch_touch(const struct ggml_tensor * src0, const struct ggml_tensor * ids, int ith, int nth) {
+#if !defined(_WIN32)
+    const int64_t n_as = src0->ne[2];
+    const size_t  page = (size_t) sysconf(_SC_PAGESIZE);
+    uint8_t * seen = (uint8_t *) alloca((size_t) n_as);
+    memset(seen, 0, (size_t) n_as);
+    volatile char sink = 0;
+    size_t k = 0;
+    for (int64_t iid1 = 0; iid1 < ids->ne[1]; ++iid1) {
+        for (int64_t id = 0; id < ids->ne[0]; ++id) {
+            const int32_t i02 = *(const int32_t *) ((const char *) ids->data + iid1*ids->nb[1] + id*ids->nb[0]);
+            if (i02 < 0 || i02 >= n_as || seen[i02]) {
+                continue;
+            }
+            seen[i02] = 1;
+            const char * base = (const char *) src0->data + (size_t) i02 * src0->nb[2];
+            for (size_t off = 0; off < src0->nb[2]; off += page, ++k) {
+                if ((int)(k % (size_t) nth) == ith) {
+                    sink += base[off];
+                }
+            }
+        }
+    }
+    (void) sink;
+#else
+    GGML_UNUSED(src0); GGML_UNUSED(ids); GGML_UNUSED(ith); GGML_UNUSED(nth);
+#endif
+}
+
+// Expert trace (measurement only): with GGML_MOE_TRACE=<file>, every single-token decode step appends one line per layer, "<tensor name> id id ...",
+// for the ffn_down_exps tensors (one op per layer per token). Used to measure how much routing repeats from one token to the next.
+static void ggml_moe_trace(const struct ggml_tensor * src0, const struct ggml_tensor * ids) {
+    static FILE * f = NULL;
+    static int init = 0;
+    if (!init) {
+        init = 1;
+        const char * path = getenv("GGML_MOE_TRACE");
+        if (path) { f = fopen(path, "a"); }
+    }
+    static FILE * fp = NULL;
+    static int initp = 0;
+    if (!initp) {
+        initp = 1;
+        const char * ppath = getenv("GGML_MOE_TRACE_PREFILL");
